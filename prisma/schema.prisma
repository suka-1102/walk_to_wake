// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  /// Google プロフィールの名前を初期値とし、マイページでアプリ内だけ上書きできる表示名。
  /// アダプタの createUser は name・email・image しか書き込まないため、
  /// NOT NULL を保つ都合上いったん空文字で作成し、lib/auth.ts の events.createUser で name を書き戻す
  displayName    String          @default("")
  accounts       Account[]
  sessions       Session[]
  savedLocations SavedLocation[]
  challenges     Challenge[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model Challenge {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// userId のコピー。終了時に null へ戻すことで「1ユーザー1チャレンジ」をこの一意制約でDBに担保する
  activeUserId   String?   @unique
  locationName   String
  latitude       Float
  longitude      Float
  deadlineHour   Int
  deadlineMinute Int
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  depositYen     Int
  /// null なら進行中。期間満了 or 早期失敗の条件を満たしたとき、アクセス時に一度だけ書き込む
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  checkIns       CheckIn[]

  @@index([userId])
}

model CheckIn {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date

  @@unique([challengeId, date])
}
